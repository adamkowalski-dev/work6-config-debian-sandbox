# shellcheck shell=bash
# ============================================================================
# work6 — manifest zainstalowanych wersji (GENEROWANY)
#
# Ten plik wypełniają moduły setup.d/ oraz scripts/update-tools.sh na
# docelowym systemie: wersja, źródło, suma i data każdej instalacji.
# Pełna historia (append-only): <work6>/state/manifest.tsv
# Nie edytuj ręcznie poza świadomym pinowaniem wersji.
# ============================================================================

# Przykładowy format (wpisy pojawią się po instalacji):
# NODE_VERSION="v24.x.y"
# NODE_SOURCE="https://nodejs.org/dist/v24.x.y/node-v24.x.y-linux-x64.tar.xz"
# NODE_SHA256="..."
# NODE_DATE="2026-07-16T12:00:00+02:00"
