# shellcheck shell=bash
# ============================================================================
# work6 — konfiguracja instalacji (szablon)
#
# Ten plik jest wypełniany przez kreator w setup-work6.sh na DOCELOWYM
# systemie i zapisywany jako <work6>/config/install.env (chmod 0600).
# Wartości poniżej to domyślne odpowiedzi kreatora.
# Nigdy nie wpisuj tu tokenów ani haseł — to tylko przełączniki.
# ============================================================================

# Dedykowany użytkownik Linux, który uruchamia agentów.
# Wszystkie launchery odmawiają startu jako root lub inny użytkownik.
AGENT_USER="ai-agent"

# Katalog środowiska. Puste = "$HOME/work6" użytkownika agenta.
WORK6_DIR=""

# --- Komponenty (yes/no) ----------------------------------------------------
INSTALL_NODE="yes"            # lokalny Node LTS (wymagany dla npm/Playwright)
INSTALL_PYTHON="yes"          # lokalny venv
INSTALL_CLAUDE="yes"          # Claude Code CLI (natywna binarka, GPG-weryfikowana)
INSTALL_AGY="yes"             # Antigravity CLI (agy)
INSTALL_PLAYWRIGHT="yes"      # Playwright + przeglądarki w work6/browsers
INSTALL_FLUTTER="yes"         # Flutter SDK (duży, ~3-4.5 GB)
INSTALL_VSCODE="yes"          # VS Code/VSCodium w trybie portable

# --- Node -------------------------------------------------------------------
# pinned     = trzymaj się linii NODE_MAJOR_PIN (aktualizacje patch/minor)
# follow-lts = zawsze najnowsza linia Active LTS (major może się zmienić —
#              w październiku 2026 LTS-em zostanie Node 26!)
NODE_POLICY="pinned"
NODE_MAJOR_PIN="24"

# --- Claude Code --------------------------------------------------------------
# Kanał wersji: stable | latest | konkretny numer (np. 2.1.204)
CLAUDE_CHANNEL="stable"
# Maksymalny dozwolony tryb autonomii dla run-claude:
#   default     — Claude pyta o każdą edycję/komendę
#   acceptEdits — auto-akcept edycji plików, komendy nadal pytają
#   bypass      — --dangerously-skip-permissions, TYLKO wewnątrz sandboxa
# Launcher domyślnie startuje w tym trybie; AGENT_CLAUDE_MODE=... może
# go jednorazowo OBNIŻYĆ, nigdy podnieść powyżej tej wartości.
CLAUDE_MAX_MODE="bypass"

# --- Antigravity (agy) --------------------------------------------------------
# Maksymalny (i domyślny) tryb autonomii dla run-agy, zawsze WEWNĄTRZ bwrap:
#   default — agy pyta o każde działanie
#   bypass  — --dangerously-skip-permissions: pełna autonomia (zapis możliwy
#             tylko w katalogach work6 widocznych w sandboxie)
# AGENT_AGY_MODE=default może go jednorazowo OBNIŻYĆ, nigdy podnieść.
AGY_MAX_MODE="bypass"

# --- Playwright ---------------------------------------------------------------
# Silniki rozdzielone spacjami: chromium firefox webkit
PLAYWRIGHT_ENGINES="chromium"

# --- Flutter ------------------------------------------------------------------
FLUTTER_CHANNEL="stable"
# Targety rozdzielone spacjami: linux web android
# (android = tylko wykrycie istniejącego SDK; niczego nie instalujemy)
FLUTTER_TARGETS="linux web"

# --- VS Code ------------------------------------------------------------------
# vscodium (rekomendowany: publikowane sumy SHA-256, bez telemetrii MS)
# vscode   (oficjalny tarball MS; brak publikowanych sum — odnotujemy hash sami)
VSCODE_FLAVOR="vscodium"
# Rozszerzenia (ID rozdzielone spacjami), np.:
# "ms-python.python dart-code.flutter ms-playwright.playwright eamodio.gitlens"
# Puste = nie instaluj żadnych.
VSCODE_EXTENSIONS=""

# --- OAuth / GUI ----------------------------------------------------------------
# desktop-session — mam osobną sesję pulpitu jako użytkownik agenta;
#                   open-agent-browser działa lokalnie
# headless-remote — brak GUI; URL-e logowania otwieram w dedykowanym
#                   profilu przeglądarki na INNYM urządzeniu
# shared-gui      — GUI istnieje, ale bez osobnej sesji agenta; loguję
#                   jak w headless-remote (nie współdzielimy sesji!)
OAUTH_MODE="desktop-session"

# Chromium z apt (do OAuth); instalowany przez prepare-system.sh.
# Jeśli "no", open-agent-browser użyje Chromium Playwrighta.
WANT_SYSTEM_CHROMIUM="yes"

# --- Udostępnienie $WORK6 innemu userowi hosta ------------------------------
# Puste = wyłączone. Ustawiony login = po każdym setup-work6.sh skrypt
# scripts/share-with-user.sh nadaje temu userowi ACL na całe drzewo work6
# (odczyt, opcjonalnie zapis) — bez ruszania izolacji sandboxa w drugą
# stronę (ai-agent nadal nie widzi hosta). Typowy przypadek: operator/admin
# maszyny chce podglądać/edytować to, co robi agent.
SHARE_WITH_USER=""
SHARE_MODE="ro"                # ro = tylko odczyt, rw = odczyt + zapis

# --- Backup ---------------------------------------------------------------------
BACKUP_KEEP="10"              # ile archiwów konfiguracji trzymać

# Ustawiane przez kreator po przejściu wszystkich pytań.
WIZARD_DONE="no"
