# shellcheck shell=bash
# ============================================================================
# work6 — strojenie sandboxa bubblewrap
#
# Logika mountów jest CELOWO w kodzie (lib/sandbox.sh), nie w konfigu —
# lista bindów to decyzja bezpieczeństwa, którą powinno się zmieniać
# świadomie, w review'owalnym pliku. Tu są tylko udokumentowane pokrętła.
# ============================================================================

# Nazwa hosta widoczna w sandboxie (--unshare-uts + --hostname).
SANDBOX_HOSTNAME="work6"

# "yes" = przekaż do sandboxa sockety X11/Wayland BIEŻĄCEJ sesji.
# Używaj WYŁĄCZNIE zalogowany do własnej sesji graficznej użytkownika
# agenta (launchery i tak odmawiają pracy na innym koncie). Potrzebne
# tylko do headed Playwright / `flutter run -d linux` w sandboxie.
SANDBOX_ALLOW_DISPLAY="no"

# Dodatkowe ścieżki montowane TYLKO DO ODCZYTU, rozdzielone dwukropkiem.
# Zostawiaj puste. Każdy wpis to świadome poszerzenie widoczności hosta.
SANDBOX_EXTRA_RO_BINDS=""

# Dodatkowe zmienne środowiskowe przekazywane do sandboxa, format:
# "NAZWA=wartość NAZWA2=wartość2". Nigdy nie wkładaj tu sekretów.
SANDBOX_EXTRA_ENV=""
